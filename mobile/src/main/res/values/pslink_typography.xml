<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PSLinkTypography" />
    <!-- Uses Android's bundled Noto Sans fallback for Arabic; no external font asset. -->
    <style name="PSLinkTypography.Display">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/pslink_text</item>
    </style>
    <style name="PSLinkTypography.Heading">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/pslink_text</item>
    </style>
    <style name="PSLinkTypography.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pslink_muted</item>
    </style>
</resources>
